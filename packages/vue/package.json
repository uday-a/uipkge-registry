{
  "name": "@uipkge/registry-vue",
  "private": true,
  "version": "0.0.0",
  "description": "Source of UIPKGE components and blocks. Builds to shadcn-vue compatible JSON.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/check-imports.ts && bun scripts/check-demo-self-ref.ts && bun scripts/build.ts",
    "dev": "vite",
    "dev:watch": "bun scripts/build.ts --watch",
    "check:imports": "bun scripts/check-imports.ts",
    "check:demo-self-ref": "bun scripts/check-demo-self-ref.ts",
    "verify": "bun scripts/verify.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "playground": "vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@studiometa/vue-mapbox-gl": "^2.7.2",
    "@tanstack/vue-form": "^1.33.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-vue-next": "^1.0.0",
    "mapbox-gl": "^3.25.0",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vue-echarts": "^8.0.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "3.5",
    "@vue/test-utils": "^2.4.11",
    "fast-glob": "^3.3.0",
    "happy-dom": "^17.6.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.0.0",
    "vitest": "^3.2.7",
    "vue": "3.5",
    "vue-tsc": "^3.3.11",
    "zod": "^3.0.0"
  }
}
