{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./bootstrap/*",
        "./components/*"
      ],
      "@/lib/use-theme": [
        "./bootstrap/use-theme/use-theme.ts"
      ],
      "@/lib/*": [
        "./bootstrap/utils/*"
      ],
      "@/ui/*": [
        "./components/*"
      ]
    }
  },
  "include": [
    "components/**/*",
    "bootstrap/**/*",
    "lib/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
